# Required application credentials
GOOGLE_GENAI_API_KEY=replace-with-google-genai-key
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
APP_TOKEN_ENCRYPTOR_PASSWORD=replace-with-a-long-random-password
APP_TOKEN_ENCRYPTOR_SALT=replace-with-a-random-salt

# Database and application ports
POSTGRES_DB=reponyx
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Browser-facing URLs. Keep these ports aligned with BACKEND_PORT and FRONTEND_PORT.
APP_FRONTEND_URL=http://localhost:${FRONTEND_PORT}
APP_CORS_ALLOWED_ORIGINS=http://localhost:${FRONTEND_PORT}
NEXT_PUBLIC_API_BASE_URL=http://localhost:${BACKEND_PORT}
